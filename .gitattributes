# Переводы строк всегда LF, включая Windows.
#
# Git на Windows по умолчанию (core.autocrlf=true) подменяет LF на CRLF при
# checkout. Код и конфиги здесь пишутся с LF, и без этой настройки после
# первого же коммита с Windows-машины диффы состояли бы из переводов строк.
* text=auto eol=lf

# Excel-выгрузки — бинарные, диффить и конвертировать нечего
*.xlsx binary
