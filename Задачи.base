filters:
  and:
    - note.type == "task"
properties:
  note.status:
    displayName: Статус
  note.current_step:
    displayName: Текущий шаг
  note.control_date:
    displayName: Контроль
  note.progress:
    displayName: Шаги
  note.stalled:
    displayName: Буксует
  note.tags:
    displayName: Категории
  file.name:
    displayName: Задача
views:
  - type: table
    name: Доска
    groupBy:
      property: status
      direction: ASC
    order:
      - file.name
      - control_date
      - current_step
      - progress
      - stalled
      - tags
  - type: table
    name: Требует внимания
    filters:
      and:
        - note.status != "закрыта"
    order:
      - control_date
      - file.name
      - current_step
      - stalled
  - type: table
    name: Буксуют
    filters:
      and:
        - note.stalled >= 3
    order:
      - stalled
      - file.name
      - current_step
